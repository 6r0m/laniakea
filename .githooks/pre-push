#!/bin/sh
# SPDX-License-Identifier: AGPL-3.0-or-later
#
# Refuses a push whose new commits carry private data, and fails closed when it cannot check.
# It reports commit, path and line, never the matched text, so a refusal does not copy the value into a log.
#
# Setup in each clone:
#   git config core.hooksPath .githooks
#   git config laniakea.forbiddenPatternsFile <patterns file outside the repository>
# The procedure around it is docs/publishing.md.

set -u
remote="$1"
zero=0000000000000000000000000000000000000000
tab=$(printf '\t')
status=0

die() { printf 'pre-push: %s\n' "$*" >&2; exit 1; }
fail() { printf 'pre-push: %s\n' "$*" >&2; status=1; }

patterns_file=$(git config --get laniakea.forbiddenPatternsFile) ||
  die "laniakea.forbiddenPatternsFile is not set; see docs/publishing.md"
[ -f "$patterns_file" ] || die "patterns file not found: $patterns_file"
compiled=$(mktemp) || die "cannot create a temporary file"
trap 'rm -f "$compiled"' EXIT
# A patterns file with CRLF endings would otherwise keep a CR in every pattern and silently match nothing.
tr -d '\r' < "$patterns_file" | grep -Ev '^[[:space:]]*(#|$)' > "$compiled"
[ -s "$compiled" ] || die "patterns file has no active pattern: $patterns_file"
printf 'x\n' | grep -E -f "$compiled" > /dev/null 2>&1
[ $? -le 1 ] || die "patterns file has an invalid pattern: $patterns_file"

name=$(git config --get user.name) || die "user.name is not set in this clone"
email=$(git config --get user.email) || die "user.email is not set in this clone"

# Line numbers of input lines that match a private pattern.
matching_lines() { LC_ALL=C grep -I -i -n -E -f "$compiled" | cut -d: -f1; }

check_commit() {
  commit="$1"
  short=$(git rev-parse --short "$commit") || die "cannot read commit $commit"
  identity=$(git log -1 --format="%an$tab%ae$tab%cn$tab%ce" "$commit") || die "cannot read commit $short"
  [ "$identity" = "$name$tab$email$tab$name$tab$email" ] ||
    fail "$short: author or committer differs from this clone's user.name and user.email"
  offsets=$(git log -1 --format='%ad %cd' --date=format:%z "$commit") || die "cannot read commit $short"
  [ "$offsets" = "+0000 +0000" ] || fail "$short: commit dates must be UTC (+0000); commit with TZ=UTC set"

  message_lines=$(git log -1 --format=%B "$commit" | matching_lines)
  for line in $message_lines; do
    fail "$short: commit message line $line matches a private pattern"
  done

  index=0
  changes=$(git -c core.quotePath=false diff-tree --root --no-commit-id -r --numstat --diff-filter=d "$commit") ||
    die "cannot list the changes of $short"
  while IFS="$tab" read -r added deleted path; do
    [ -n "$path" ] || continue
    index=$((index + 1))
    case "$path" in
      workspace/*) fail "$short: $path is under workspace/, which only ever holds analysed-project data" ;;
    esac
    if printf '%s\n' "$path" | LC_ALL=C grep -q -i -E -f "$compiled"; then
      fail "$short: changed path $index matches a private pattern (see git show --stat $short)"
      continue
    fi
    if [ "$added" = "-" ]; then
      fail "$short: $path is binary; binaries are not accepted"
      continue
    fi
    # Checked first: a failed git show inside the pipe below would otherwise read as no match.
    git cat-file -e "$commit:$path" 2> /dev/null || die "cannot read $path in $short"
    content_lines=$(git show "$commit:$path" | matching_lines)
    for line in $content_lines; do
      fail "$short: $path:$line matches a private pattern"
    done
  done <<EOF
$changes
EOF
}

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    commits=$(git rev-list "$local_sha" --not --remotes="$remote") || die "cannot list commits for $local_ref"
  else
    commits=$(git rev-list "$remote_sha..$local_sha") || die "cannot list commits for $local_ref"
  fi
  for commit in $commits; do
    check_commit "$commit"
  done
done

[ "$status" -eq 0 ] || printf 'pre-push: push refused; nothing was sent\n' >&2
exit "$status"
